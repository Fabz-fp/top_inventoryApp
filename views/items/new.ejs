<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Add a new product to SoundBurrow inventory.">
  <title><%= title %> | SoundBurrow</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%- include("../partials/header.ejs") %>

  <main class="container">
    <section class="form-section">
      <a href="/">← Back to Home</a>

      <h1>Add a Product</h1>

      <% if (typeof errors !== "undefined" && errors.length > 0) { %>
        <ul class="error-list">
          <% errors.forEach((error) => { %>
            <li><%= error %></li>
          <% }) %>
        </ul>
      <% } %>

      <form action="/items/new" method="POST">
        <div class="form-group">
          <label for="name">Product Name</label>
          <input
            type="text"
            id="name"
            name="name"
            maxlength="150"
            value="<%= typeof item !== 'undefined' ? item.name : '' %>"
            required
          >
        </div>

        <div class="form-group">
          <label for="description">Description</label>
          <textarea
            id="description"
            name="description"
            rows="4"
          ><%= typeof item !== 'undefined' ? item.description : '' %></textarea>
        </div>

        <div class="form-group">
          <label for="brand">Brand</label>
          <input
            type="text"
            id="brand"
            name="brand"
            maxlength="100"
            value="<%= typeof item !== 'undefined' ? item.brand : '' %>"
          >
        </div>

        <div class="form-group">
          <label for="model">Model</label>
          <input
            type="text"
            id="model"
            name="model"
            maxlength="100"
            value="<%= typeof item !== 'undefined' ? item.model : '' %>"
          >
        </div>

        <div class="form-group">
          <label for="sku">SKU</label>
          <input
            type="text"
            id="sku"
            name="sku"
            maxlength="50"
            value="<%= typeof item !== 'undefined' ? item.sku : '' %>"
            required
          >
        </div>

        <div class="form-group">
          <label for="price">Price ($)</label>
          <input
            type="number"
            id="price"
            name="price"
            min="0"
            max="99999999.99"
            step="0.01"
            value="<%= typeof item !== 'undefined' ? item.price : '' %>"
            required
          >
        </div>

        <div class="form-group">
          <label for="stock_quantity">Stock Quantity</label>
          <input
            type="number"
            id="stock_quantity"
            name="stock_quantity"
            min="0"
            step="1"
            value="<%= typeof item !== 'undefined' ? item.stock_quantity : 0 %>"
            required
          >
        </div>

        <div class="form-group">
          <label for="image_url">Image URL</label>
          <input
            type="url"
            id="image_url"
            name="image_url"
            value="<%= typeof item !== 'undefined' ? item.image_url : '' %>"
          >
        </div>

        <div class="form-group">
          <label for="specifications">Specifications</label>
          <textarea
            id="specifications"
            name="specifications"
            rows="4"
          ><%= typeof item !== 'undefined' ? item.specifications : '' %></textarea>
        </div>

        <div class="form-group">
          <label for="category_id">Category</label>
          <select id="category_id" name="category_id" required>
            <option value="">Select a category</option>

            <% categories.forEach((category) => { %>
              <option
                value="<%= category.id %>"
                <%= typeof item !== "undefined" &&
                    String(item.category_id) === String(category.id)
                    ? "selected"
                    : "" %>
              >
                <%= category.name %>
              </option>
            <% }) %>
          </select>
        </div>

        <button type="submit">Add Product</button>
      </form>
    </section>
  </main>

  <%- include("../partials/footer.ejs") %>
</body>
</html>