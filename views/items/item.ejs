<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= item.name %> at SoundBurrow.">
  <title><%= title %> | SoundBurrow</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%- include("../partials/header.ejs") %>

  <main class="container">
    <a href="/categories/<%= item.category_id %>">
      ← Back to <%= item.category_name %>
    </a>

    <section class="product-details">
      <% if (item.image_url) { %>
        <img src="<%= item.image_url %>" alt="<%= item.name %>">
      <% } %>

      <div class="product-info">
        <h1><%= item.name %></h1>

        <p><strong>Brand:</strong> <%= item.brand || "Not specified" %></p>
        <p><strong>Model:</strong> <%= item.model || "Not specified" %></p>
        <p><strong>SKU:</strong> <%= item.sku %></p>

        <p class="product-price">
          $<%= Number(item.price).toFixed(2) %>
        </p>

        <p>
          <strong>Availability:</strong>
          <%= item.stock_quantity > 0
            ? `${item.stock_quantity} in stock`
            : "Out of stock" %>
        </p>

        <h2>Description</h2>
        <p><%= item.description || "No description available." %></p>

        <% if (item.specifications) { %>
          <h2>Specifications</h2>
          <p><%= item.specifications %></p>
        <% } %>
      </div>
    </section>
  </main>

  <%- include("../partials/footer.ejs") %>
</body>
</html>